# IHMS Emergency — environment configuration
# Copy this file to .env and adjust values for your machine.

# SQLite database file path (relative or absolute)
DATABASE_URL=file:./db/custom.db

# Secret used for session signing and Socket.IO service auth.
# Set to a long random string in production!
# IHMS_SECRET=change-me-to-a-long-random-string

# URL of the socket emit endpoint (default works for local run)
# IHMS_SOCKET_URL=http://127.0.0.1:3004
